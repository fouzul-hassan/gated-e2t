@startuml "EEG-to-Text Architecture with JEPA Pretraining"

!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam RoundCorner 10
skinparam Shadowing false
skinparam PackageBorderThickness 2
skinparam NoteBorderThickness 1

title <size:18><b>Two-Stage EEG-to-Text Architecture</b></size>\n<size:13>Stage 1: Signal-JEPA Self-Supervised Pretraining → Stage 2: EEG-to-Text Fine-tuning</size>

' ============================================================================================
' STAGE 1: SIGNAL-JEPA PRETRAINING
' ============================================================================================

package "**Stage 1: Signal-JEPA Pretraining** (Self-Supervised, ~3.5h on 1 GPU)" as Stage1 #E8F5E9 {

    rectangle "<b>Raw EEG Input</b>\n(batch, 1280, 128)\n1280 time points × 128 channels\nVoltage values in μV" as EEG_RAW #BBDEFB

    rectangle "<b>Patch Embedding</b>\n<i>nn.Conv1d(128, 128, kernel=8, stride=8)</i>\n<i>+ 1D Sinusoidal Positional Encoding</i>\npatch_size = 8 → 160 patches\n(batch, 160, 128)" as PATCH #90CAF9

    rectangle "<b>SSP Masking</b>\n<i>Semantic Subsequence Preserving</i>\nSelects contiguous temporal chunks\nmask_ratio = 50%\n→ 80 visible + 80 masked patches" as SSP #FFF9C4

    rectangle "<b>Context Encoder</b>\n<color:#2E7D32><b>6× EncoderBlock (GLIM)</b></color>\n128 dim, 8 heads, MLP ratio 4\n<i>Self-Attention + LayerNorm + MLP</i>\n<b>✓ Gated Attention (optional)</b>\n\nVisible patches only\n(batch, 80, 128)" as CTX_ENC #C8E6C9

    rectangle "<b>Target Encoder</b>\n<color:#558B2F><b>6× EncoderBlock (EMA copy)</b></color>\n<i>Momentum = 0.99</i>\n<b>⛔ No gradients (stop-grad)</b>\n\nMasked patches only\n(batch, 80, 128)" as TGT_ENC #DCEDC8

    rectangle "<b>Predictor</b>\n<color:#F57F17><b>2× CrossAttnPredictorBlock</b></color>\nCross-Attention: query = mask tokens\n                 key/value = context output\n+ LayerNorm + MLP\n\nPredicts masked representations\n(batch, 80, 128)" as PREDICTOR #FFF8E1

    rectangle "<b>VICReg Loss</b>\n<color:#C62828><b>ℒ = α·ℒ_align + β·ℒ_var + γ·ℒ_cov</b></color>\n\nℒ_align: MSE between predicted & target\nℒ_var: variance regularization (≥1.0)\nℒ_cov: off-diagonal covariance → 0\n\n<i>Prevents representation collapse</i>" as VICREG #FFCDD2

    ' ── Connections ──
    EEG_RAW -down-> PATCH : ""
    PATCH -down-> SSP : ""
    SSP -down-> CTX_ENC : "visible\npatches"
    SSP -down-> TGT_ENC : "masked\npatches"
    CTX_ENC -right-> PREDICTOR : "context\nrepresentations"
    TGT_ENC -down-> VICREG : "target\nrepresentations"
    PREDICTOR -down-> VICREG : "predicted\nrepresentations"
    CTX_ENC .right.> TGT_ENC : "<i>EMA update\n(τ=0.99)</i>"

    note right of CTX_ENC
        <b>Key Design Decision:</b>
        Uses the exact same EncoderBlock
        class as the downstream model.
        Enables zero-friction weight transfer.
    end note

    note bottom of VICREG
        <b>Why VICReg over Contrastive?</b>
        No negative pairs needed.
        EEG negative pairs are hard to define.
        Final: loss = 0.356, var = 0.990
    end note
}

' ============================================================================================
' WEIGHT TRANSFER ARROW
' ============================================================================================

rectangle "<b>Weight Transfer</b>\n<i>load_pretrained_encoder()</i>\nContext Encoder → EEG Encoder in_blocks\nShape-matched key-by-key loading\n<b>Only the 6 EncoderBlocks are transferred</b>" as TRANSFER #FFE0B2

Stage1 -down-> TRANSFER : "Pretrained\nweights"

' ============================================================================================
' STAGE 2: EEG-TO-TEXT FINE-TUNING
' ============================================================================================

package "**Stage 2: EEG-to-Text Fine-tuning** (200 epochs, bf16-mixed)" as Stage2 #E3F2FD {

    ' ── INPUT ROW ──
    rectangle "<b>Raw EEG Input</b>\n(n, 1280, 128)\ntime × channels" as EEG_IN #BBDEFB

    rectangle "<b>Input Text</b>\n\"To English: <sentence>\"\nTokenized by LLM tokenizer\nmax_len = 96" as TEXT_IN #F8BBD0

    rectangle "<b>Target Text</b>\n(ground truth sentence)\nTokenized, max_len = 64\n8 text variants available" as TGT_TEXT #F8BBD0

    rectangle "<b>Prompt Embedder</b>\n<color:#4527A0><b>3 Learned Embedding Tables</b></color>\n\nTask: <NR> / <TSR> (3 tokens)\nDataset: ZuCo1 / ZuCo2 (3 tokens)\nSubject: 31 subject IDs\n\n<i>Dropout: task=0%, dataset=100%, subject=100%</i>\n→ Prompt embedding (n, 128)" as P_EMBED #D1C4E9

    ' ── EEG ENCODER ──
    package "**EEG Encoder** (Backbone + Q-Merger)" as EEG_ENCODER #C8E6C9 {

        rectangle "<b>+ Sinusoidal Positional Encoding</b>\n1D pos_embed (1280, 128)\n(n, 1280, 128)" as POS_EMB #E8F5E9

        rectangle "<b>Backbone: 6× EncoderBlock</b>\n<color:#2E7D32><b>★ JEPA Pretrained Weights</b></color>\n\nEach block:\n├─ <b>Temporal Modulate</b> (condition on prompt p)\n├─ <b>adaLN</b> (shift, scale, gate from prompt)\n├─ <b>Gated Self-Attention</b> (8 heads)\n│   gate = σ(W_g · query) ⊙ Attn(Q,K,V)\n│   <i>Learns to suppress noisy channels</i>\n├─ LayerNorm\n└─ MLP (ratio=4, GELU)\n\nInput/Output: (n, 1280, 128)\nMask-aware: ignores padded time steps" as BACKBONE #A5D6A7

        rectangle "<b>Projection</b>\n<i>nn.Linear(128 → 256) + LayerNorm</i>\n(n, 1280, 128) → (n, 1280, 256)" as PROJ #81C784

        rectangle "<b>Learned Queries</b>\n<i>nn.Parameter</i>\n92 learnable tokens × 256 dim\n(1, 92, 256) → broadcast to batch" as QUERIES #CE93D8

        rectangle "<b>Q-Merger: 6× DecoderBlock</b>\n<color:#6A1B9A><b>Cross-Attention over EEG</b></color>\n\nEach block:\n├─ <b>Gated Self-Attention</b> (causal)\n│   Queries attend to each other\n├─ <b>Cross-Attention</b>\n│   Q = learned queries\n│   K, V = encoder output (1280 tokens)\n│   <i>Compresses 1280 → 96 tokens</i>\n│   Mask-aware: ignores padded positions\n├─ LayerNorm\n└─ MLP (ratio=4, GELU)\n\n+ 4 prompt tokens prepended → 96 total\nOutput: (n, 96, 256)" as Q_MERGER #B39DDB

        ' connections inside encoder
        POS_EMB -down-> BACKBONE
        BACKBONE -down-> PROJ
        PROJ -down-> Q_MERGER : "EEG hidden\nstates (K, V)"
        QUERIES -right-> Q_MERGER : "learned\nqueries (Q)"
    }

    ' ── TEXT ENCODER ──
    rectangle "<b>Text Encoder</b>\n<color:#78909C><b>Flan-T5-Large Encoder (frozen)</b></color>\n<b>⛔ No gradients</b>\n\nEncodes input text to hidden states\n(n, 96, 1024)" as TEXT_ENC #CFD8DC

    ' ── ALIGNER ──
    package "**Cross-Modal Aligner**" as ALIGNER_PKG #B2EBF2 {

        rectangle "<b>EEG Embedding Branch</b>\n<i>nn.Linear(256 → 1024) + LayerNorm</i>\nEEG hiddens → text embedding space\n(n, 96, 256) → (n, 96, 1024)\n\n<b>Pooling:</b> mean → (n, 1024)\nEEG embedding vector" as ALIGN_EEG #80DEEA

        rectangle "<b>Text Embedding Branch</b>\n<i>nn.Linear(1024 → 1024)</i>\nText hiddens → aligned space\n(n, 96, 1024) → (n, 96, 1024)\n\n<b>Pooling:</b> mean → (n, 1024)\nText embedding vector" as ALIGN_TEXT #80DEEA

        rectangle "<b>CLIP-style Contrastive Loss</b>\n<color:#00838F><b>ℒ_CLS = CrossEntropy(sim_matrix / τ)</b></color>\n\nsim_matrix: (n, n) cosine similarities\nEEG embeddings ↔ Text embeddings\nτ = learned temperature\n\nAligns EEG and text in shared space" as CLIP_LOSS #B2EBF2
    }

    ' ── TEXT DECODER ──
    rectangle "<b>Text Decoder</b>\n<color:#78909C><b>Flan-T5-Large Decoder (frozen)</b></color>\n<b>⛔ No gradients</b>\n\nAutoregressive text generation\nCross-attention to EEG embeddings\n(n, 96, 1024) → (n, 64, vocab)\n\nGeneration: beam search (k=2)\nor nucleus sampling (p=0.95)" as TEXT_DEC #CFD8DC

    ' ── LOSSES ──
    rectangle "<b>Language Modeling Loss</b>\n<color:#C62828><b>ℒ_LM = CrossEntropy(logits, target)</b></color>\n\nTeacher-forced training\nPad tokens masked with -100\n(n, 64, vocab_size)" as LM_LOSS #FFCDD2

    rectangle "<b>Total Loss</b>\n<color:#C62828><b>ℒ = ℒ_LM + λ · ℒ_CLS + ε · ℒ_commit</b></color>\n\nλ = 0.5 (CLIP weight)\nε = 0.0 (commitment disabled)\n\n<b>Optimizer:</b> AdamW (lr=1e-4)" as TOTAL_LOSS #EF9A9A

    ' ── OUTPUT ──
    rectangle "<b>Generated Text</b>\n\"The movie presents a compelling...\"\n\nMetrics: BLEU-1/2/3/4, ROUGE-1/2/L" as OUTPUT #F48FB1

    ' ══════════ CONNECTIONS ══════════

    ' Input connections
    EEG_IN -down-> POS_EMB : "(n, 1280, 128)"
    P_EMBED -down-> BACKBONE : "prompt\nconditioning"
    TEXT_IN -down-> TEXT_ENC

    ' Encoder output to Aligner
    Q_MERGER -down-> ALIGN_EEG : "EEG hidden\nstates\n(n, 96, 256)"
    TEXT_ENC -down-> ALIGN_TEXT : "text hidden\nstates\n(n, 96, 1024)"
    ALIGN_EEG -down-> CLIP_LOSS : "EEG emb\n(n, 1024)"
    ALIGN_TEXT -down-> CLIP_LOSS : "text emb\n(n, 1024)"

    ' EEG embeddings to decoder
    ALIGN_EEG -right-> TEXT_DEC : "EEG sequence\nembeddings\n(n, 96, 1024)"
    TGT_TEXT -down-> TEXT_DEC : "target\ntoken IDs"

    ' Decoder to loss
    TEXT_DEC -down-> LM_LOSS : "logits\n(n, 64, vocab)"
    LM_LOSS -down-> TOTAL_LOSS
    CLIP_LOSS -down-> TOTAL_LOSS

    ' Output
    TEXT_DEC -right-> OUTPUT : "beam search\ndecoding"

    note right of BACKBONE
        <b>Gated Attention (Novel):</b>
        gate = σ(W_g · Q)
        output = gate ⊙ softmax(QK^T/√d) · V

        Sigmoid gates introduce non-linearity
        and enable query-dependent sparsity.
        → Implicit artifact suppression
        → Per-channel noise filtering
    end note
}

TRANSFER -down-> EEG_ENCODER : "6× EncoderBlock\nweights only"

' ============================================================================================
' TRAINING CONFIGURATION
' ============================================================================================

note bottom of Stage2
    <b>Training Configuration</b>
    ├─ GPU: Single GPU, bf16-mixed precision
    ├─ Batch size: 72 (train), 24 (val)
    ├─ Epochs: 200, checkpoint every 10
    ├─ Seed: 42, deterministic
    ├─ Dataset: ZuCo (22,335 samples)
    │   ├─ ZuCo1: task1 (Sentiment), task2 (Normal), task3 (Relation)
    │   └─ ZuCo2: task1, task2
    └─ LLM: Flan-T5-Large (770M params, frozen)
end note

legend right
    |= Color |= Component |= Status |
    |<#C8E6C9> | EEG Encoder (Backbone) | ★ JEPA Pretrained, fine-tuned |
    |<#D1C4E9> | Q-Merger | Trained from scratch |
    |<#B2EBF2> | Cross-Modal Aligner | Trained from scratch |
    |<#CFD8DC> | LLM (Flan-T5-Large) | Frozen (pretrained) |
    |<#FFF9C4> | Masking / Preprocessing | Fixed (not learned) |
    |<#FFCDD2> | Loss Functions | — |
endlegend

@enduml
